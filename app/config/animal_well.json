{
  "_comment": "Reproduction of the animal-well benchmark of Zheng et al. 2025 (their Figure 4) with the asset and parameters of the libuipc AL-release example: dt 0.01, d_hat 0.002, SNH E=5e5 nu=0.3 rho=1e3, K_min 2, eps 1e-3, CG tol 1e-4, 300 frames, friction off. The container is pool1.obj, the coarse 2x2x2 open box the libuipc example uses (pool.obj is the same surface subdivided 26x26). d_hat is the paper's delta = 1e-3; the libuipc example uses 2e-3. Assets: run asset/animal_well/fetch.sh first (the 71 MB tet mesh is included in asset/animal_well).",
  "simulation": {
    "dt": 0.01,
    "frames": 300,
    "gravity": [0, -9.81, 0],
    "output_dir": "output/animal_well",
    "save_bgeo": true,
    "save_every": 1
  },
  "contact": {
    "enable": true,
    "d_hat": 0.001,
    "epsilon": 1e-3,
    "K_min": 2,
    "max_outer_iters": 500,
    "decay_factor": 0.9,
    "decay_remove_threshold": 0.01,
    "mu_mode": "diag_max",
    "mu_scale": 0.1,
    "alpha_lower_bound": 1e-6,
    "toi_tie_tolerance": 1e-6,
    "stall": { "iters": 50, "alpha": 1e-4, "mu_factor": 2.0, "d_hat_factor": 0.5, "max_adaptations": 10 },
    "ccd": { "s": 0.1, "max_iter": 100, "float_screen": false, "rebuild_quality_ratio": 1.5 },
    "inversion_free": "auto",
    "self_collision_default": true,
    "exclude_one_ring_pairs": false,
    "drop_parallel_edge_pairs": false,
    "toi_filter_domain": "paper",
    "friction": { "enable": false, "eps_v": 1e-3, "normal_force": "paper" }
  },
  "newton": {
    "inner_max_iters": 8,
    "line_search": { "max_halvings": 30, "energy_tolerance": 1e-12 },
    "early_accept_velocity_tol": 0
  },
  "linear_solver": { "type": "pcg", "preconditioner": "block_jacobi", "rel_tol": 1e-4, "max_iters": 2000, "check_interval": 8 },
  "materials": {
    "animal": { "model": "SNH", "E": 500000.0, "nu": 0.3, "density": 1000.0, "snh_lambda_reparam": true }
  },
  "bodies": [
    {
      "name": "animals",
      "type": "tet",
      "file": "animal_well/animal_well.msh",
      "material": "animal",
      "move_to_origin": false,
      "scale": [1, 1, 1],
      "rotation": [0, 0, 0],
      "translation": [0, 0, 0],
      "initial_velocity": [0, 0, 0],
      "thickness": 0.0,
      "friction": 0.0,
      "self_collision": true
    }
  ],
  "colliders": [
    {
      "name": "pool",
      "type": "tri",
      "file": "animal_well/pool1.obj",
      "thickness": 0.0,
      "friction": 0.0,
      "scale": [1, 1, 1],
      "rotation": [0, 0, 0],
      "translation": [0, 0, 0],
      "motion": null
    }
  ],
  "planes": [],
  "contact_table": { "exclude": [], "friction": [] },
  "logging": { "level": "info", "stats_csv": "stats.csv", "timing": true, "debug_check_penetration": false }
}
